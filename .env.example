# Optional process environment overrides. The server does not auto-load .env.
HANDSHAKE_PORT=8800
HANDSHAKE_HOST=127.0.0.1
HANDSHAKE_DB=./data/handshake.sqlite3
# For HTTPS hosting, set the public origin without a path. Vercel detects its default domains.
# HANDSHAKE_PUBLIC_URL=https://your-app.example
# Hosting providers' PORT is used when HANDSHAKE_PORT is not set.
# Replace the local demonstration staff password for any shared use.
HANDSHAKE_STAFF_PASSWORD=<choose-a-password>
HANDSHAKE_CALLBACK_SECRET=<choose-a-secret>
# Vercel requires a hosted libSQL database; local runs can keep using SQLite.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=<database-token>
